{
    "name": "orion.primitives.timesnet.TimesNet",
    "contributors": [
        "Sarah Alnegheimish <smish@mit.edu>"
    ],
    "documentation": "https://arxiv.org/pdf/2210.02186",
    "description": "time series transformer for anomaly detection",
    "classifiers": {
        "type": "estimator",
        "subtype": "regressor"
    },
    "modalities": [],
    "primitive": "orion.primitives.timesnet.TimesNet",
    "fit": {
        "method": "fit",
        "args": [
            {
                "name": "X",
                "type": "ndarray"
            }
        ]
    },
    "produce": {
        "method": "predict",
        "args": [
            {
                "name": "X",
                "type": "ndarray"
            }
        ],
        "output": [
            {
                "name": "y",
                "type": "ndarray"
            },
            {
                "name": "energy",
                "type": "ndarray"
            },
            {
                "name": "train_energy",
                "type": "ndarray"
            }
        ]
    },
    "hyperparameters": {
        "fixed": {
            "optimizer": {
                "type": "str",
                "default": "torch.optim.Adam"
            },
            "input_size": {
                "type": "int",
                "default": 1
            },
            "output_size": {
                "type": "int",
                "default": 1
            },
            "window_size": {
                "type": "int",
                "default": 100
            },
            "pred_len": {
                "type": "int",
                "default": 0
            },
            "step": {
                "type": "int",
                "default": 1
            },
            "top_k": {
                "type": "int",
                "default": 3
            },
            "d_model": {
                "type": "int",
                "default": 512
            },
            "d_ff": {
                "type": "int",
                "default": 2048
            },
            "num_layers": {
                "type": "int",
                "default": 2
            },
            "num_kernels": {
                "type": "int",
                "default": 6
            },
            "features": {
                "type": "str",
                "default": "M"
            },
            "embed": {
                "type": "str",
                "default": "fixed"
            },
            "freq": {
                "type": "str",
                "default": "h"
            },
            "dropout": {
                "type": "int",
                "default": 0.0
            },
            "learning_rate": {
                "type": "float",
                "default": 0.0001
            },
            "epochs": {
                "type": "int",
                "default": 10
            },
            "batch_size": {
                "type": "int",
                "default": 256
            },
            "shuffle": {
                "type": "bool",
                "default": true
            },
            "valid_split": {
                "type": "float",
                "default": 0.0
            },
            "cuda": {
                "type": "bool",
                "default": true
            },
            "verbose": {
                "type": "bool",
                "default": true
            }
        }
    }
}

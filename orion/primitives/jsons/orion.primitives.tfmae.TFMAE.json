{
    "name": "orion.primitives.tfmae.TFMAE",
    "contributors": [
        "Sarah Alnegheimish <smish@mit.edu>"
    ],
    "documentation": "https://github.com/LMissher/TFMAE/blob/main/paper/TFMAE.pdf",
    "description": "time series transformer for anomaly detection",
    "classifiers": {
        "type": "estimator",
        "subtype": "regressor"
    },
    "modalities": [],
    "primitive": "orion.primitives.tfmae.TFMAE",
    "fit": {
        "method": "fit",
        "args": [
            {
                "name": "X",
                "type": "ndarray"
            }
        ]
    },
    "produce": {
        "method": "predict",
        "args": [
            {
                "name": "X",
                "type": "ndarray"
            }
        ],
        "output": [
            {
                "name": "energy",
                "type": "ndarray"
            },
            {
                "name": "train_energy",
                "type": "ndarray"
            }
        ]
    },
    "hyperparameters": {
        "fixed": {
            "optimizer": {
                "type": "str",
                "default": "torch.optim.Adam"
            },
            "input_size": {
                "type": "int",
                "default": 1
            },
            "output_size": {
                "type": "int",
                "default": 1
            },
            "window_size": {
                "type": "int",
                "default": 100
            },
            "seq_size": {
                "type": "int",
                "default": 10
            },
            "step": {
                "type": "int",
                "default": 1
            },
            "k": {
                "type": "int",
                "default": 3
            },
            "d_model": {
                "type": "int",
                "default": 512
            },
            "n_hidden": {
                "type": "int",
                "default": 512
            },
            "fr": {
                "type": "float",
                "default": 0.4
            },
            "tr": {
                "type": "float",
                "default": 0.5
            },
            "num_layers": {
                "type": "int",
                "default": 3
            },
            "learning_rate": {
                "type": "float",
                "default": 0.0001
            },
            "epochs": {
                "type": "int",
                "default": 10
            },
            "batch_size": {
                "type": "int",
                "default": 64
            },
            "temperature": {
                "type": "int",
                "default": 50
            },
            "shuffle": {
                "type": "bool",
                "default": true
            },
            "valid_split": {
                "type": "float",
                "default": 0.2
            },
            "cuda": {
                "type": "bool",
                "default": true
            },
            "verbose": {
                "type": "bool",
                "default": true
            }
        }
    }
}
